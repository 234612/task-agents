# ==================== LLM 配置 ====================
# 通义千问 / OpenAI 兼容接口
LLM_MODEL=qwen3.8-max
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.7

# ==================== MySQL 配置 ====================
# 用于存储会话元数据（会话列表、用户隔离）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=task_agents

# ==================== MongoDB 配置 ====================
# 用于存储对话历史详情（messages 数组，高频追加写）
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=task_agents
MONGO_SESSION_COLLECTION=chat_sessions

# ==================== Redis 配置 ====================
# 用于存储当前会话上下文（短期记忆）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 上下文窗口：保留最近 N 轮对话（1 轮 = user + assistant 各一条）
REDIS_CONTEXT_MAX_TURNS=10
# 上下文 TTL（秒），默认 7 天
REDIS_CONTEXT_TTL_SECONDS=604800

# ==================== 应用配置 ====================
# FastAPI 服务配置
APP_DEBUG=false
CORS_ORIGINS=*

# 会话列表分页
SESSION_PAGE_SIZE=20
SESSION_PAGE_SIZE_MAX=100

# ==================== 程序员工具配置 ====================
# 程序员子 Agent 的文件读写与代码执行沙箱
# 留空则默认为 backend/workspace/（Agent 生成的代码不入库）
CODER_WORKSPACE_DIR=

# 代码执行超时（秒），防止死循环挂住请求
CODER_EXEC_TIMEOUT_SECONDS=15

# 单次工具输出最大字符数，防止撑爆上下文
CODER_MAX_OUTPUT_CHARS=8000

# 单文件读写上限（字节）
CODER_MAX_FILE_BYTES=2000000
